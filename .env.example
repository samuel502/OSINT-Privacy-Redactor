# Copy to .env and fill in. .env is gitignored, so the key never reaches the repo
# and never appears on a command line (and therefore never in ~/.bash_history).
GROQ_API_KEY=your-key-here
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_REASONING_EFFORT=low
GEMINI_API_KEY=your-key-here
# GEMINI_MODEL=gemini-flash-latest
# LLM_PROVIDER=groq
